<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de IIS que se une al web.config que genera "Publish".
  Permite subir el reporte de Voices en la pantalla /recuperar/ (CSV de ~4 GB).
  IIS por defecto solo acepta 30 MB; el máximo que permite IIS es 4294967295 bytes (~4 GB).
  Para archivos más grandes, subir el .zip (pesa ~10 veces menos).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
